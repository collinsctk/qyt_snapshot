{
  "save_dir": "",
  "hotkeys": {
    "capture": {
      "display": "Ctrl+Shift+Z",
      "shortcut": "ctrl+shift+z"
    },
    "repeat_capture": {
      "display": "Ctrl+Shift+X",
      "shortcut": "ctrl+shift+x"
    }
  },
  "ai_settings": {
    "base_url": "https://aihubmix.com/v1",
    "api_key": "",
    "model": "gpt-4.1-nano"
  },
  "marker_style": {
    "fill": "#ffff6b6b",
    "border": "#ffffaa00",
    "border_enabled": true,
    "size": 28,
    "font_ratio": 1.2,
    "next_number": 1
  },
  "rectangle_style": {
    "fill": "#00000000",
    "border": "#ff1dd1a1",
    "border_enabled": true,
    "width": 4,
    "radius": 0
  },
  "image_quality": 70,
  "auto_save_enabled": false,
  "auto_start_enabled": false,
  "close_behavior": "tray",
  "exit_unsaved_policy": "save_all",
  "workspace_zoom": 1.0
}
